{
  "name": "@dertobi/website-kern",
  "version": "1.0.1",
  "description": "Gemeinsame Bausteine aller Kunden-Websites (Website-Standard S6)",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "css"
  ],
  "exports": {
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    },
    "./danke": {
      "types": "./dist/danke.d.ts",
      "default": "./dist/danke.js"
    },
    "./scanner": {
      "types": "./dist/scanner.d.ts",
      "default": "./dist/scanner.js"
    },
    "./matomo": {
      "types": "./dist/matomo.d.ts",
      "default": "./dist/matomo.js"
    },
    "./seitenaufruf-route": {
      "types": "./dist/seitenaufruf-route.d.ts",
      "default": "./dist/seitenaufruf-route.js"
    },
    "./seitenwechsel": {
      "types": "./dist/seitenwechsel.d.ts",
      "default": "./dist/seitenwechsel.js"
    },
    "./robots": {
      "types": "./dist/robots.d.ts",
      "default": "./dist/robots.js"
    },
    "./next-config": {
      "types": "./dist/next-config.d.ts",
      "default": "./dist/next-config.js"
    },
    "./reveal": {
      "types": "./dist/reveal.d.ts",
      "default": "./dist/reveal.js"
    },
    "./motion-presets": {
      "types": "./dist/motion-presets.d.ts",
      "default": "./dist/motion-presets.js"
    },
    "./interaktion.css": "./css/interaktion.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && sed -i.bak -E 's#(from \"\\./[a-z-]+)\\.ts\"#\\1.js\"#g' dist/*.d.ts && rm dist/*.bak",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "gsap": ">=3.13",
    "next": ">=16",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "gsap": "3.15.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
